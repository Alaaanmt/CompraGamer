generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model categorias {
  id        Int         @id @default(autoincrement())
  nombre    String      @db.VarChar(100)
  productos productos[]
}

model marcas {
  id        Int         @id @default(autoincrement())
  nombre    String      @db.VarChar(100)
  logo_url  String?     @db.VarChar(255)
  productos productos[]
}

model producto_imagenes {
  id          Int       @id @default(autoincrement())
  producto_id Int
  imagen_url  String    @db.VarChar(255)
  productos   productos @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "producto_imagenes_ibfk_1")

  @@index([producto_id], map: "producto_id")
}

model productos {
  id                Int                 @id @default(autoincrement())
  nombre            String              @db.VarChar(255)
  descripcion       String?             @db.Text
  precio            Decimal             @db.Decimal(12, 2)
  stock             Int
  marca_id          Int
  categoria_id      Int
  producto_imagenes producto_imagenes[]
  marcas            marcas              @relation(fields: [marca_id], references: [id], onUpdate: Restrict, map: "productos_ibfk_1")
  categorias        categorias          @relation(fields: [categoria_id], references: [id], onUpdate: Restrict, map: "productos_ibfk_2")

  @@index([categoria_id], map: "categoria_id")
  @@index([marca_id], map: "marca_id")
}

model usuarios {
  id         Int            @id @default(autoincrement())
  email      String         @unique(map: "email") @db.VarChar(255)
  contrasena String         @db.VarChar(255)
  nombre     String         @db.VarChar(100)
  apellido   String         @db.VarChar(100)
  direccion  String         @db.VarChar(255)
  role       usuarios_role? @default(USER)
}

enum usuarios_role {
  USER
  ADMIN
}
